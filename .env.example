# 控制器
CONTROLLER_PORT=8000
LOG_LEVEL=INFO
DATABASE_URL=sqlite:////app/data/app.db

# 镜像
GATEWAY_IMAGE=ldm/proxy-gateway:latest
VNC_IMAGE=ldm/android-vnc:latest
# arm64 宿主机（Apple Silicon / ARM 服务器）
REDROID_IMAGE=redroid/redroid:13.0.0_64only-latest
# x86_64 宿主机改成： redroid/redroid:13.0.0-latest

# 设备默认参数
DEVICE_WIDTH=720
DEVICE_HEIGHT=1280
DEVICE_DPI=320
REDROID_GPU_MODE=guest

# 设备端口分配区间（每设备占 2 个端口：adb / novnc）
DEVICE_PORT_BASE=21000
DEVICE_PORT_MAX=21999

# Docker 网络（网关容器接入的桥接网络）
DOCKER_NETWORK=ldm_net

# 采集
DEFAULT_INTERVAL_SECONDS=60
MAX_CONCURRENT_TASKS=8
# 可选：外挂选择器目录，覆盖内置 YAML
SELECTORS_DIR=

# 录屏
RECORD_SEGMENT_SECONDS=170
RECORD_BITRATE=4000000
RECORD_KEEP_SEGMENTS=false

# DNS（网关内 dnsproxy 的上游，防 DNS 泄漏；逗号分隔多个）
# 主上游用加密 DNS；部分网络会封 DoH/DoT，用 fallback 的 TCP 明文兜底，
# 兜底同样经 tun→代理出去，不会泄漏真实 IP。
GATEWAY_DNS_UPSTREAM=https://1.1.1.1/dns-query,tls://1.1.1.1
GATEWAY_DNS_FALLBACK=tcp://1.1.1.1:53,tcp://8.8.8.8:53
